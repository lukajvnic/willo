{
  "expo": {
    "name": "Willo",
    "slug": "willo",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "willo",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.willo.app"
    },
    "android": {
      "package": "com.willo.app"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
